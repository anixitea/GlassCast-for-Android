<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Form-factor declarations. Every one is required=false: this is a single
      APK that must install on both a phone and a Google TV box, and marking
      leanback required would hide it from phones while marking touchscreen
      required would hide it from TVs.
    -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app updates from GitHub Releases: lets GlassCast hand a downloaded
         update to Android's installer. Android still asks the user to allow
         it once, and confirms every install. (Play forbids self-updating apps;
         this is for the GitHub build.) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".GlassCastApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.GlassCast">

        <!--
          configChanges: every change the app can follow without being rebuilt.
          smallestScreenSize covers split screen and ColorOS's floating windows,
          density a display-size or app-scaling change, keyboard and navigation
          a keyboard cover. Anything missing from this list recreates the
          activity, which used to replay the launch animation from the start.
        -->
        <activity
            android:name=".GlassCastActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Theme.GlassCast">

            <!--
              Receiving an OPML subscription list from another podcast app's
              share sheet. Exporters label OPML as text/xml, application/xml or
              octet-stream depending on the app, so the filter is broad and the
              parser decides whether the file is really OPML.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/x-opml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Opening an .opml straight from a file manager. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/x-opml" />
            </intent-filter>
        </activity>

        <!--
          The launcher entries, one per app icon (2.0, data/AppIcons). Exactly
          one is enabled at a time; picking an icon in Settings enables its
          alias and disables the rest. The original keeps the name the
          activity itself had until 2.0, ".MainActivity", so an icon already
          on someone's home screen still points at an entry that exists. The
          activity is GlassCastActivity now, and is never disabled.
        -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Midnight"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_midnight"
            android:roundIcon="@mipmap/ic_launcher_midnight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Paper"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_paper"
            android:roundIcon="@mipmap/ic_launcher_paper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.SeaGlass"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_sea_glass"
            android:roundIcon="@mipmap/ic_launcher_sea_glass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Pebble"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_pebble"
            android:roundIcon="@mipmap/ic_launcher_pebble">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Shore"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_shore"
            android:roundIcon="@mipmap/ic_launcher_shore">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Tide"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_tide"
            android:roundIcon="@mipmap/ic_launcher_tide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Lagoon"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_lagoon"
            android:roundIcon="@mipmap/ic_launcher_lagoon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Rose"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_rose"
            android:roundIcon="@mipmap/ic_launcher_rose">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Amber"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_amber"
            android:roundIcon="@mipmap/ic_launcher_amber">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Mint"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_mint"
            android:roundIcon="@mipmap/ic_launcher_mint">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.LiquidGlass"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_liquid_glass"
            android:roundIcon="@mipmap/ic_launcher_liquid_glass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Prism"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_prism"
            android:roundIcon="@mipmap/ic_launcher_prism">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Clear"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_clear"
            android:roundIcon="@mipmap/ic_launcher_clear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.Dark"
            android:targetActivity=".GlassCastActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          The TV entry point. LEANBACK_LAUNCHER is what puts it on the Google TV
          home row; a TV launcher ignores the plain LAUNCHER category on
          the phone's launcher aliases, so the two never appear together.

          Landscape is locked because a television has no other orientation, and
          leaving it sensor-driven lets a box with an accelerometer do something
          absurd.
        -->
        <activity
            android:name=".tv.TvActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|navigation"
            android:theme="@style/Theme.GlassCast.Tv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares a downloaded update with the system installer, and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Google Cast: which receiver to launch, and the transfer receiver
             that lets the system hand playback between phone and TV. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.glasscast.app.player.CastOptionsProvider" />
        <receiver
            android:name="androidx.mediarouter.media.MediaTransferReceiver"
            android:exported="true" />

        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- The home-screen widget (widget/NowPlayingWidget). -->
        <receiver
            android:name=".widget.NowPlayingWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>

        <!-- The TV's Google sign-in client, from local.properties (see app/build.gradle.kts). -->
        <meta-data
            android:name="com.glasscast.app.tv_client_id"
            android:value="${tvClientId}" />
        <meta-data
            android:name="com.glasscast.app.tv_client_secret"
            android:value="${tvClientSecret}" />

        <!-- Android Auto: GlassCast as a media app (see player/AutoLibrary). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Covers for Android Auto, which only loads content:// images. Read-only;
             serves library artwork only (see player/ArtworkProvider). -->
        <provider
            android:name=".player.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true" />
    </application>
</manifest>
