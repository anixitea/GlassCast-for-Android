<?xml version="1.0" encoding="utf-8"?>
<!--
  The 1.5 icon: Jonathan's purple gradient as the background layer and the rounded
  glyph as the foreground, both PNGs in drawable-nodpi (432px = 108dp at
  xxxhdpi). The glyph spans 54% of the *visible* icon — a launcher shows the
  middle 72dp of the 108dp layer, so that's 36% of the layer. Sizing it against
  the whole layer is what made earlier icons look zoomed in.

  No night variant, on purpose: the icon is the same in light and dark. (A
  night copy of the icon or its layers also outranks this file at night — the
  1.3 "zoomed dark icon" bug — so keep it that way.)

  The monochrome layer is only for themed icons, when someone turns them on:
  the launcher discards the colors and tints the glyph's silhouette.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
