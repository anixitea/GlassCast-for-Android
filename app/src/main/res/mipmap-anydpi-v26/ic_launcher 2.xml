<?xml version="1.0" encoding="utf-8"?>
<!--
  There is deliberately no night copy of this file, and no night PNG set.
  Night-mode resources OUTRANK density in Android's qualifier order, so a
  mipmap-night-hdpi PNG beats mipmap-anydpi-v26 at night — the launcher stopped
  using the adaptive icon after dark and fell back to a flat, full-bleed image,
  which is why the dark icon looked zoomed in. Only the two drawable layers are
  night-qualified now; the adaptive icon stays in charge in both modes.

  The monochrome layer is the one dark-mode-adjacent feature Android actually
  guarantees: with themed icons switched on, the launcher throws away the
  background and tints this glyph from the system palette, so it follows light
  and dark automatically. It must be a solid silhouette — the launcher supplies
  the colour.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
